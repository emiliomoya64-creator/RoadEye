<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>RoadEye</title>

    <link
        rel="stylesheet"
        href="/static/css/style.css"
    >
</head>

<body>
    <header class="app-header">
        <div class="brand">
            <span class="brand-icon">◉</span>

            <div>
                <h1>ROAD EYE</h1>
                <p>Dashcam inteligente</p>
            </div>
        </div>

        <nav class="header-actions">
            <button
                class="icon-button"
                type="button"
                data-popup="videos"
                title="Explorar vídeos"
            >
                <span class="button-icon">▣</span>
                <span>Vídeos</span>
            </button>

            <button
                class="icon-button"
                type="button"
                data-popup="settings"
                title="Configuración"
            >
                <span class="button-icon">⚙</span>
                <span>Ajustes</span>
            </button>
        </nav>
    </header>

    <main class="dashboard">
        <section class="camera-panel">
            <div class="panel-heading">
                <div>
                    <span class="live-dot"></span>
                    Cámara frontal
                </div>

                <span id="connectionStatus">
                    Conectando…
                </span>
            </div>

            <div class="video-frame">
                <img
                    id="videoStream"
                    src="/video"
                    alt="Vídeo en directo de RoadEye"
                >
            </div>
        </section>

        <section class="status-grid">
            <article class="status-card">
                <span class="status-label">
                    Grabación
                </span>

                <strong id="recordingState">
                    Inicializando…
                </strong>

                <div class="record-actions">
                    <button
                        id="start"
                        class="action-button start-button"
                        type="button"
                    >
                        Grabar
                    </button>

                    <button
                        id="stop"
                        class="action-button stop-button"
                        type="button"
                    >
                        Parar
                    </button>
                </div>
            </article>

            <article class="status-card">
                <span class="status-label">
                    GPS
                </span>

                <strong id="gpsState">
                    Sin señal
                </strong>

                <span id="speedState" class="secondary-value">
                    0 km/h
                </span>
            </article>

            <article class="status-card">
                <span class="status-label">
                    Sistema
                </span>

                <strong id="systemState">
                    Comprobando…
                </strong>

                <span id="systemDetails" class="secondary-value">
                    CPU · Temperatura
                </span>
            </article>

            <article class="status-card">
                <span class="status-label">
                    Almacenamiento
                </span>

                <strong id="diskState">
                    -- %
                </strong>

                <span id="videosState" class="secondary-value">
                    0 vídeos
                </span>
            </article>
        </section>
    </main>

    <!-- ===================================================
         POPUP MANAGER
         =================================================== -->

    <div
        id="popupBackdrop"
        class="popup-backdrop"
        aria-hidden="true"
    >
        <section
            id="popupWindow"
            class="popup-window"
            role="dialog"
            aria-modal="true"
            aria-labelledby="popupTitle"
        >
            <header class="popup-header">
                <div>
                    <span id="popupEyebrow" class="popup-eyebrow">
                        RoadEye
                    </span>

                    <h2 id="popupTitle">
                        Ventana
                    </h2>
                </div>

                <button
                    id="popupClose"
                    class="popup-close"
                    type="button"
                    aria-label="Cerrar ventana"
                >
                    ×
                </button>
            </header>

            <div id="popupContent" class="popup-content"></div>
        </section>
    </div>

    <script src="/static/js/app.js"></script>
</body>
</html>
