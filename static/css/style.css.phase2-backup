:root {
    color-scheme: dark;

    font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    --background: #070a0c;
    --panel: #11171b;
    --panel-light: #182126;
    --border: #29363d;
    --text: #f3f6f7;
    --muted: #91a0a7;
    --accent: #35c878;
    --accent-dark: #113d28;
    --danger: #ef5757;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    color: var(--text);
    background:
        radial-gradient(
            circle at top,
            #172328 0,
            var(--background) 42%
        );
}

body.popup-open {
    overflow: hidden;
}

button {
    font: inherit;
}

.app-header {
    position: sticky;
    top: 0;
    z-index: 20;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;

    min-height: 84px;
    padding: 14px clamp(18px, 4vw, 48px);

    border-bottom: 1px solid var(--border);

    background:
        rgba(7, 10, 12, 0.88);

    backdrop-filter: blur(18px);
}

.brand {
    display: flex;
    align-items: center;
    gap: 13px;
}

.brand-icon {
    display: grid;
    place-items: center;

    width: 45px;
    height: 45px;

    color: var(--accent);
    font-size: 1.7rem;

    border: 1px solid #286844;
    border-radius: 14px;

    background: var(--accent-dark);
}

.brand h1 {
    margin: 0;
    font-size: 1.35rem;
    letter-spacing: 0.09em;
}

.brand p {
    margin: 3px 0 0;
    color: var(--muted);
    font-size: 0.8rem;
}

.header-actions {
    display: flex;
    gap: 10px;
}

.icon-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    min-height: 44px;
    padding: 0 14px;

    color: var(--text);

    border: 1px solid var(--border);
    border-radius: 12px;

    background: var(--panel-light);
    cursor: pointer;
}

.icon-button:hover {
    border-color: #3c4d55;
    background: #202b30;
}

.button-icon {
    font-size: 1.15rem;
}

.dashboard {
    width: min(100%, 1400px);
    margin: 0 auto;
    padding: 24px clamp(14px, 3vw, 34px) 60px;
}

.camera-panel {
    overflow: hidden;

    border: 1px solid var(--border);
    border-radius: 20px;

    background: var(--panel);

    box-shadow:
        0 24px 75px rgba(0, 0, 0, 0.38);
}

.panel-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;

    min-height: 52px;
    padding: 0 18px;

    color: var(--muted);
    font-size: 0.88rem;
}

.panel-heading > div {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--text);
    font-weight: 700;
}

.live-dot {
    width: 9px;
    height: 9px;

    border-radius: 50%;
    background: var(--danger);

    box-shadow:
        0 0 13px rgba(239, 87, 87, 0.8);
}

#connectionStatus.online {
    color: var(--accent);
}

.video-frame {
    position: relative;

    overflow: hidden;
    aspect-ratio: 16 / 9;

    background: #030405;
}

.video-frame img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: contain;
}

.status-grid {
    display: grid;

    grid-template-columns:
        repeat(
            4,
            minmax(0, 1fr)
        );

    gap: 16px;
    margin-top: 18px;
}

.status-card {
    min-height: 145px;
    padding: 19px;

    border: 1px solid var(--border);
    border-radius: 17px;

    background:
        linear-gradient(
            160deg,
            rgba(25, 34, 39, 0.97),
            rgba(13, 19, 22, 0.97)
        );
}

.status-label {
    display: block;
    margin-bottom: 13px;

    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.status-card strong {
    display: block;
    font-size: 1.25rem;
}

.status-card strong.recording {
    color: var(--danger);
}

.secondary-value {
    display: block;
    margin-top: 9px;

    color: var(--muted);
    font-size: 0.9rem;
}

.record-actions {
    display: flex;
    gap: 9px;
    margin-top: 16px;
}

.action-button {
    flex: 1;

    min-height: 39px;

    color: var(--text);
    font-weight: 750;

    border: 0;
    border-radius: 10px;

    cursor: pointer;
}

.start-button {
    background: #17673c;
}

.stop-button {
    background: #8d2929;
}

.action-button:disabled {
    cursor: not-allowed;
    opacity: 0.35;
}

/* ==========================================================
   POPUP MANAGER
   ========================================================== */

.popup-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1000;

    display: grid;
    place-items: center;

    padding: 20px;

    background:
        rgba(0, 0, 0, 0.72);

    backdrop-filter: blur(9px);

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition:
        opacity 180ms ease,
        visibility 180ms ease;
}

.popup-backdrop.visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
}

.popup-window {
    display: flex;
    flex-direction: column;

    width: min(1100px, 96vw);
    height: min(820px, 92vh);

    overflow: hidden;

    border: 1px solid #33434b;
    border-radius: 20px;

    background: #0c1114;

    box-shadow:
        0 34px 100px rgba(0, 0, 0, 0.65);

    transform:
        translateY(18px)
        scale(0.985);

    transition:
        transform 180ms ease;
}

.popup-backdrop.visible .popup-window {
    transform:
        translateY(0)
        scale(1);
}

.popup-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    min-height: 73px;
    padding: 13px 18px 13px 22px;

    border-bottom: 1px solid var(--border);

    background: #11181c;
}

.popup-header h2 {
    margin: 3px 0 0;
    font-size: 1.25rem;
}

.popup-eyebrow {
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.popup-close {
    display: grid;
    place-items: center;

    width: 45px;
    height: 45px;

    color: var(--text);
    font-size: 2rem;
    line-height: 1;

    border: 1px solid var(--border);
    border-radius: 12px;

    background: var(--panel-light);
    cursor: pointer;
}

.popup-content {
    flex: 1;
    min-height: 0;
    overflow: auto;
}

.popup-frame {
    display: block;

    width: 100%;
    height: 100%;

    border: 0;
    background: #080b0d;
}

.empty-state {
    display: grid;
    place-items: center;
    align-content: center;

    min-height: 100%;
    padding: 40px;

    color: var(--muted);
    text-align: center;
}

.empty-state h3 {
    margin: 14px 0 8px;
    color: var(--text);
    font-size: 1.35rem;
}

.empty-state p {
    max-width: 520px;
    margin: 0;
    line-height: 1.6;
}

.empty-icon {
    display: grid;
    place-items: center;

    width: 76px;
    height: 76px;

    color: var(--accent);
    font-size: 2.2rem;

    border: 1px solid #275f41;
    border-radius: 21px;

    background: var(--accent-dark);
}

@media (max-width: 950px) {
    .status-grid {
        grid-template-columns:
            repeat(
                2,
                minmax(0, 1fr)
            );
    }
}

@media (max-width: 620px) {
    .app-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .header-actions {
        width: 100%;
    }

    .icon-button {
        flex: 1;
        justify-content: center;
    }

    .status-grid {
        grid-template-columns: 1fr;
    }

    .popup-backdrop {
        padding: 0;
    }

    .popup-window {
        width: 100%;
        height: 100%;

        border: 0;
        border-radius: 0;
    }
}


/* ==========================================================
   EXPLORADOR DE VÍDEOS
   ========================================================== */

.video-browser {
    display: flex;
    flex-direction: column;
    min-height: 100%;
}

.video-browser-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;

    padding: 15px 18px;

    border-bottom: 1px solid var(--border);
    background: #10171a;
}

.video-browser-toolbar strong {
    display: block;
}

.video-browser-toolbar span {
    display: block;

    max-width: 620px;
    margin-top: 4px;

    overflow: hidden;

    color: var(--muted);
    font-size: 0.76rem;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.video-browser-layout {
    display: grid;

    grid-template-columns:
        minmax(290px, 0.8fr)
        minmax(380px, 1.5fr);

    flex: 1;
    min-height: 0;
}

.video-list {
    overflow-y: auto;

    padding: 10px;

    border-right: 1px solid var(--border);
    background: #0c1114;
}

.video-list-item {
    display: grid;

    grid-template-columns:
        42px
        minmax(0, 1fr)
        auto;

    align-items: center;
    gap: 11px;

    width: 100%;
    min-height: 72px;
    margin-bottom: 7px;
    padding: 10px 11px;

    color: var(--text);
    text-align: left;

    border: 1px solid transparent;
    border-radius: 12px;

    background: #151d21;
    cursor: pointer;
}

.video-list-item:hover {
    background: #1b252a;
}

.video-list-item.selected {
    border-color: #318b59;
    background: #173024;
}

.video-list-icon {
    display: grid;
    place-items: center;

    width: 38px;
    height: 38px;

    color: var(--accent);

    border-radius: 10px;
    background: var(--accent-dark);
}

.video-list-main {
    min-width: 0;
}

.video-list-main strong {
    display: block;

    overflow: hidden;

    font-size: 0.89rem;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.video-list-main span {
    display: block;
    margin-top: 5px;

    color: var(--muted);
    font-size: 0.72rem;
}

.video-kind {
    padding: 5px 7px;

    color: var(--muted);
    font-size: 0.66rem;
    font-weight: 800;
    text-transform: uppercase;

    border-radius: 7px;
    background: #263137;
}

.video-kind.event {
    color: #ffc76b;
    background: #4b3514;
}

.video-kind.parking {
    color: #74baff;
    background: #163551;
}

.video-player-panel {
    min-width: 0;
    overflow: auto;
    background: #070a0c;
}

.player-empty,
.browser-empty,
.browser-loading,
.browser-error {
    display: grid;
    place-items: center;
    align-content: center;

    min-height: 100%;
    padding: 35px;

    color: var(--muted);
    text-align: center;
}

.player-empty strong,
.browser-empty strong {
    margin-top: 13px;
    color: var(--text);
}

.player-empty span,
.browser-empty span {
    margin-top: 7px;
}

.player-content {
    padding: 18px;
}

.player-content.hidden,
.hidden {
    display: none !important;
}

#videoPlayer {
    display: block;

    width: 100%;
    max-height: 62vh;

    border: 1px solid var(--border);
    border-radius: 14px;

    background: black;
}

.player-metadata {
    padding: 15px 2px;
}

.player-metadata strong {
    display: block;

    overflow-wrap: anywhere;
}

.player-metadata span {
    display: block;
    margin-top: 6px;

    color: var(--muted);
    font-size: 0.82rem;
}

.player-actions {
    display: flex;
    gap: 10px;
}

.browser-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 40px;
    padding: 0 14px;

    color: var(--text);
    font-weight: 750;
    text-decoration: none;

    border: 1px solid var(--border);
    border-radius: 10px;

    background: var(--panel-light);
    cursor: pointer;
}

.browser-button.danger {
    color: #ffd4d4;
    border-color: #673535;
    background: #4b2020;
}

.browser-error {
    color: var(--danger);
}

@media (max-width: 820px) {
    .video-browser-layout {
        grid-template-columns: 1fr;
    }

    .video-list {
        max-height: 290px;

        border-right: 0;
        border-bottom: 1px solid var(--border);
    }

    .video-player-panel {
        min-height: 360px;
    }
}
