{
    "project": {
        "name": "RoadEye",
        "version_file": "VERSION",
        "environment": "development"
    },
    "camera": {
        "front": {
            "enabled": true,
            "type": "csi",
            "sensor": "imx219",
            "width": 1280,
            "height": 720,
            "format": "RGB888",
            "fps": 30
        },
        "rear": {
            "enabled": false,
            "type": "usb",
            "device": "/dev/video0"
        },
        "left": {
            "enabled": false,
            "type": "usb",
            "device": "/dev/video1"
        },
        "right": {
            "enabled": false,
            "type": "usb",
            "device": "/dev/video2"
        }
    },
    "render": {
        "enabled": true,
        "fps": 30
    },
    "display": {
        "hdmi": {
            "enabled": true,
            "width": 1280,
            "height": 720,
            "fps": 30,
            "connector": "HDMI-A-1",
            "driver": "vc4"
        }
    },
    "web": {
        "enabled": true,
        "host": "0.0.0.0",
        "port": 8000,
        "jpeg_quality": 85
    },
    "gps": {
        "enabled": true,
        "port": "/dev/serial0",
        "baudrate": 9600,
        "map_service": true
    },
    "recording": {
        "enabled": false,
        "folder": "videos",
        "fps": 20,
        "segment_seconds": 30,
        "protect_events": true
    },
    "hud": {
        "enabled": true,
        "profile": "normal",
        "top_opacity": 0.65,
        "info_opacity": 0.5,
        "info_position": "bottom",
        "show": {
            "recording": true,
            "parking": true,
            "gps": true,
            "speed": true,
            "snapshot": true,
            "gallery": true,
            "speed_limit": true,
            "road": true,
            "coordinates": true,
            "date": true,
            "time": true,
            "settings": true
        }
    },
    "adas": {
        "enabled": false,
        "lanes": false,
        "vehicles": false,
        "pedestrians": false,
        "signs": false,
        "collision_warning": false
    },
    "startup": {
        "enabled": true,
        "splash_seconds": 1.2,
        "ready_seconds": 1.8,
        "check_delay_seconds": 0.3,
        "publish_fps": 15
    },
    "system": {
        "timezone": "Europe/Madrid",
        "log_level": "INFO",
        "service_name": "roadeye.service"
    },
    "test": {},
    "trips": {
        "enabled": true,
        "folder": "trips",
        "moving_speed_threshold_kmh": 3.0
    }
}
