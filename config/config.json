{
    "project": {
        "name": "RoadEye",
        "version_file": "VERSION",
        "environment": "development"
    },
    "camera": {
        "front": {
            "enabled": true,
            "type": "csi",
            "sensor": "imx219",
            "width": 1280,
            "height": 720,
            "format": "RGB888",
            "fps": 30,
            "flip_horizontal": false,
            "flip_vertical": false
        },
        "rear": {
            "enabled": false,
            "type": "usb",
            "device": "/dev/video0"
        },
        "left": {
            "enabled": false,
            "type": "usb",
            "device": "/dev/video1"
        },
        "right": {
            "enabled": false,
            "type": "usb",
            "device": "/dev/video2"
        }
    },
    "render": {
        "enabled": true,
        "fps": 30
    },
    "display": {
        "hdmi": {
            "enabled": true,
            "width": 1280,
            "height": 720,
            "fps": 30,
            "connector": "HDMI-A-1",
            "driver": "vc4"
        }
    },
    "web": {
        "enabled": true,
        "host": "0.0.0.0",
        "port": 8000,
        "jpeg_quality": 85
    },
    "gps": {
        "enabled": true,
        "port": "/dev/serial0",
        "baudrate": 9600,
        "map_service": true
    },
    "recording": {
        "enabled": false,
        "folder": "videos",
        "fps": 20.0,
        "segment_seconds": 180.0,
        "protect_events": true
    },
    "hud": {
        "enabled": true,
        "profile": "normal",
        "top_opacity": 1.0,
        "info_opacity": 0.8,
        "info_position": "bottom",
        "show": {
            "recording": true,
            "parking": true,
            "gps": true,
            "speed": true,
            "snapshot": true,
            "gallery": true,
            "speed_limit": true,
            "road": true,
            "coordinates": true,
            "date": true,
            "time": true,
            "settings": true
        },
        "icon_scale": 2.0,
        "text_scale": 2.0,
        "font": "duplex",
        "color": "white",
        "mode": "day",
        "bar_color": "black",
        "top_bar_scale": 1.6,
        "info_bar_scale": 1.6
    },
    "adas": {
        "enabled": false,
        "lanes": false,
        "vehicles": false,
        "pedestrians": false,
        "signs": false,
        "collision_warning": false
    },
    "startup": {
        "enabled": true,
        "splash_seconds": 1.2,
        "ready_seconds": 1.8,
        "check_delay_seconds": 0.3,
        "publish_fps": 15
    },
    "system": {
        "timezone": "Europe/Madrid",
        "log_level": "INFO",
        "service_name": "roadeye.service"
    },
    "test": {},
    "trips": {
        "enabled": true,
        "folder": "trips",
        "moving_speed_threshold_kmh": 3.0
    },
    "photos": {
        "folder": "photos",
        "jpeg_quality": 95,
        "thumbnail_width": 480,
        "thumbnail_quality": 82
    },
    "storage": {
        "enabled": true,
        "max_usage_percent": 85.0,
        "minimum_free_gb": 10.0,
        "check_interval_seconds": 60,
        "clean_on_start": true,
        "clean_before_recording": true,
        "delete_oldest_normal": true,
        "never_delete_protected": true,
        "clean_video_orphans": true,
        "delete_empty_trips": true,
        "dry_run": false
    },
    "parking": {
        "enabled": false,
        "trigger": "motion_or_impact",
        "pre_event_seconds": 10.0,
        "record_seconds": 15.0,
        "extend_seconds": 15.0,
        "max_event_seconds": 120.0,
        "cooldown_seconds": 5.0,
        "motion_sensitivity": 0.55,
        "protect_recording": true,
        "capture_photo": false
    }
}
